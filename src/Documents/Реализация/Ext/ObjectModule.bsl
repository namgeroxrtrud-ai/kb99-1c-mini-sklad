
#Область ОбработчикиСобытий

// Формирует расходные движения и проверяет, достаточно ли товара
// на остатках. При нехватке отменяет проведение документа.
Процедура ОбработкаПроведения(Отказ, Режим)

	// Подготавливаем расходные движения без записи в регистр.
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина;

	// Подготавливаем движения оборотного регистра.
    Движения.ОборотыТоваров.Записывать = Истина;
    Движения.ОборотыТоваров.Очистить();

	СписокТоваров = Новый Массив;
	ТребуетсяПоТоварам = Новый Соответствие;

	Для Каждого СтрокаТоваров Из Товары Цикл

		Количество = ТребуетсяПоТоварам.Получить(СтрокаТоваров.Товар);

		Если Количество = Неопределено Тогда
			Количество = 0;
			СписокТоваров.Добавить(СтрокаТоваров.Товар);
		КонецЕсли;

		ТребуетсяПоТоварам.Вставить(СтрокаТоваров.Товар,Количество + СтрокаТоваров.Количество);

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Количество = СтрокаТоваров.Количество;

		// Фиксируем количество реализованного товара.
        ДвижениеОбороты = Движения.ОборотыТоваров.Добавить();
        ДвижениеОбороты.Период = Дата;
        ДвижениеОбороты.Товар = СтрокаТоваров.Товар;
        ДвижениеОбороты.КоличествоРеализовано = СтрокаТоваров.Количество;

	КонецЦикла;

	Если СписокТоваров.Количество() > 0 Тогда

		// Получаем остатки перед текущим документом.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Остатки.Товар КАК Товар,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(
		|		&Граница,
		|		Товар В (&СписокТоваров)) КАК Остатки";

		ГраницаПроверки = Новый Граница(
		МоментВремени(),
		ВидГраницы.Исключая);

		Запрос.УстановитьПараметр("Граница", ГраницаПроверки);
		Запрос.УстановитьПараметр("СписокТоваров", СписокТоваров);

		ОстаткиПоТоварам = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			ОстаткиПоТоварам.Вставить(
			Выборка.Товар,
			Выборка.КоличествоОстаток);
		КонецЦикла;

		// Сравниваем остатки с общей потребностью по товарам.
		Для Каждого ТоварИКоличество Из ТребуетсяПоТоварам Цикл

			Остаток = ОстаткиПоТоварам.Получить(
			ТоварИКоличество.Ключ);

			Если Остаток = Неопределено Тогда
				Остаток = 0;
			КонецЕсли;

			Если Остаток < ТоварИКоличество.Значение Тогда

				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон(
				"Недостаточно товара %1. Не хватает: %2 ед.",
				ТоварИКоличество.Ключ,
				ТоварИКоличество.Значение - Остаток);
				Сообщение.Сообщить();

				Отказ = Истина;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	// Записываем движения только после успешной проверки.
	Если Не Отказ Тогда
		Движения.Записать();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти