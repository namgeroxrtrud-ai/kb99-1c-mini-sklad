
#Область ОбработчикиСобытий

// Формирует расходные движения и проверяет, достаточно ли товара
// на остатках. При нехватке отменяет проведение документа.
Процедура ОбработкаПроведения(Отказ, Режим)

	// Формируем расходные движения.
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();

	СписокТоваров = Новый Массив;

	Для Каждого СтрокаТоваров Из Товары Цикл

		СписокТоваров.Добавить(СтрокаТоваров.Товар);

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Количество = СтрокаТоваров.Количество;

	КонецЦикла;

	// Записываем движения до проверки остатков.
	// При перепроведении прежние движения заменяются новыми.
	Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина;
	Движения.Записать();

	Если СписокТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Получаем остатки с учетом движений текущего документа.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|		&Граница,
	|		Товар В (&СписокТоваров)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";

	ГраницаПроверки = Новый Граница(МоментВремени(), ВидГраницы.Включая);

	Запрос.УстановитьПараметр("Граница", ГраницаПроверки);
	Запрос.УстановитьПараметр("СписокТоваров", СписокТоваров);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Недостаточно товара %1. Не хватает: %2 ед.",Выборка.Товар,-Выборка.КоличествоОстаток);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти