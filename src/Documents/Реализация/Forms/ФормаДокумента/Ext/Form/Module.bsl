
&НаКлиенте
Процедура ПечатьРеализации(Команда)
	// Получаем готовую печатную форму с сервера.
	ТабДок = СформироватьПечатнуюФормуНаСервере();

	// Открываем печатную форму пользователю.
	ТабДок.Показать("Реализация товаров");

КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФормуНаСервере()

	Макет = Документы.Реализация.ПолучитьМакет("ПечатьРеализации");

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.АвтоМасштаб = Истина;

	// Заполняем шапку документа.
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");

	ОбластьШапка.Параметры.НомерДокумента = Объект.Номер;
	ОбластьШапка.Параметры.ДатаДокумента =
		Формат(Объект.Дата, "ДФ=dd.MM.yyyy HH:mm:ss");
	ОбластьШапка.Параметры.Контрагент = Объект.Контрагент;

	ТабДок.Вывести(ОбластьШапка);

	// Выводим заголовки таблицы.
	ОбластьЗаголовок = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	ТабДок.Вывести(ОбластьЗаголовок);

	// Выводим товары из табличной части.
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаТовара");

	ИтогоКоличество = 0;

	Для Каждого СтрокаТовара Из Объект.Товары Цикл

		ОбластьСтрока.Параметры.Товар = СтрокаТовара.Товар;
		ОбластьСтрока.Параметры.Количество = СтрокаТовара.Количество;

		ТабДок.Вывести(ОбластьСтрока);

		ИтогоКоличество = ИтогоКоличество + СтрокаТовара.Количество;

	КонецЦикла;

	// Выводим итоговое количество.
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	ОбластьИтог.Параметры.ИтогоКоличество = ИтогоКоличество;

	ТабДок.Вывести(ОбластьИтог);

	Возврат ТабДок;

КонецФункции
